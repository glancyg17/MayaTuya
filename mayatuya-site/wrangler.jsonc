{
  // Maya Tuya — static site served by Cloudflare Workers (static assets).
  // The Worker name must match the project name in the Cloudflare dashboard (Workers Builds requirement).
  "name": "mayatuya",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "routes": [{ "pattern": "new.mayatuya.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
